<style is:global>
  .stage text { font-family: var(--font-mono); fill: var(--fg-mid); font-size: 12px; font-weight: 600; letter-spacing: .06em; }
  .stage text.sign { font-size: 40px; font-weight: 700; letter-spacing: .22em; }
  .stage text.sign.warm { fill: #ffd678; filter: url(#fGlowBig); }
  .stage text.sign.cool { fill: #7fd9ff; filter: url(#fGlowBig); }
  .stage text.sub { font-size: 10px; fill: var(--fg-mute); font-weight: 400; letter-spacing: .12em; }
  .stage text.tiny { font-size: 10px; fill: var(--fg-mute); letter-spacing: .08em; }
  .stage text.g { fill: var(--bch-400); }
  .stage text.v { fill: var(--neon-300); }
  .stage text.w { fill: var(--warn); }
  .stage text.d { fill: var(--danger); }
  .stage text.dim { fill: var(--fg-dim); }

  /* camera */
  .stage .world {
    transform: scale(var(--cam-z)) translate(calc(var(--cam-x) * -1px), calc(var(--cam-y) * -1px));
    transform-origin: 0 0;
    transition: transform 1.25s cubic-bezier(.65, 0, .3, 1);
  }

  /* hero */
  .stage .hero { transform: translate(calc(var(--hx) * 1px), 560px); transition: transform var(--walk-dur, 900ms) cubic-bezier(.45, 0, .35, 1); }
  .stage .hero .body { transform-origin: 0 0; animation: idle 2.6s ease-in-out infinite; }
  .stage.walking .hero .body { animation: walkbob .32s ease-in-out infinite; }
  .stage .leg { transform-box: fill-box; transform-origin: 50% 0; }
  .stage.walking .leg-l { animation: legswing .32s ease-in-out infinite; }
  .stage.walking .leg-r { animation: legswing .32s ease-in-out infinite reverse; }
  @keyframes idle { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-2.5px); } }
  @keyframes walkbob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes legswing { 0%,100% { transform: rotate(-28deg); } 50% { transform: rotate(28deg); } }

  .stage .glow { opacity: 0; transition: opacity .8s; }
  .stage.f-filled .glow { opacity: 1; }
  .stage .liq-level { transition: transform 1.4s cubic-bezier(.3, 0, .2, 1); }
  .stage.f-filled .liq-level { transform: translateY(-60px); }
  .stage .seal { opacity: 0; transform: translate(25px, -24px) scale(.2); transform-origin: 25px -24px; transition: opacity .3s, transform .5s cubic-bezier(.2, 1.4, .4, 1); }
