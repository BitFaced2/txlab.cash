---
/**
 * The world: three rooms side by side in one SVG. The camera pans and zooms
 * between them; the hero (the transaction) walks through all three.
 *   room 1  x    0–1200  the wallet
 *   room 2  x 1200–2400  the network
 *   room 3  x 2400–3600  inside a full node: the validation gauntlet
 * All motion is CSS driven by flags (`f-*`) and data attributes that the
 * scroll engine sets on the <svg>.
 */
let seed = 7;
const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const stars = Array.from({ length: 90 }, () => ({ x: 1200 + rnd() * 1200, y: rnd() * 470, r: 0.6 + rnd() * 1.3, o: 0.3 + rnd() * 0.6 }));
const win = Array.from({ length: 16 }, () => ({ x: 985 + rnd() * 170, y: 200 + rnd() * 90, r: 0.5 + rnd() }));

type N = { x: number; y: number; ring: number };
const origin: N = { x: 1250, y: 400, ring: 0 };
const ring1: N[] = [[1420, 300], [1450, 470], [1380, 180]].map(([x, y]) => ({ x, y, ring: 1 }));
const ring2: N[] = [[1610, 140], [1650, 300], [1600, 470], [1720, 400], [1560, 360], [1690, 190]].map(([x, y]) => ({ x, y, ring: 2 }));
const ring3: N[] = [[1830, 100], [1860, 260], [1800, 400], [1900, 500], [1960, 170], [2010, 330], [1950, 440], [2080, 110], [2120, 250], [2160, 420], [2050, 520], [2200, 160]].map(([x, y]) => ({ x, y, ring: 3 }));
const ourNode: N = { x: 2325, y: 268, ring: 4 };
const dist = (a: N, b: N) => Math.hypot(a.x - b.x, a.y - b.y);
const nearest = (from: N, pool: N[], k: number) => [...pool].sort((a, b) => dist(from, a) - dist(from, b)).slice(0, k);
type E = { a: N; b: N; ring: number };
const edges: E[] = [];
for (const n of ring1) edges.push({ a: origin, b: n, ring: 1 });
for (const n of ring2) for (const p of nearest(n, ring1, 2)) edges.push({ a: p, b: n, ring: 2 });
for (const n of ring3) for (const p of nearest(n, ring2, 2)) edges.push({ a: p, b: n, ring: 3 });
for (const p of nearest(ourNode, ring3, 3)) edges.push({ a: p, b: ourNode, ring: 4 });
---

<div class="stage-wrap">
  <svg class="stage" viewBox="0 0 1200 700" xmlns="http://www.w3.org/2000/svg" role="img"
       aria-label="An animated stage showing one Bitcoin Cash transaction, drawn as a small glass flask with a face, moving from a wallet, across the network, and through a full node's validation checks."
       data-mood="blank" data-step="born" style="--cam-x:0;--cam-y:0;--cam-z:1;--hx:600">
    <defs>
      <radialGradient id="gGlow"><stop offset="0" stop-color="#3fe5b5" stop-opacity=".55"/><stop offset="1" stop-color="#3fe5b5" stop-opacity="0"/></radialGradient>
      <radialGradient id="gLampWarm"><stop offset="0" stop-color="#ffd678" stop-opacity=".22"/><stop offset="1" stop-color="#ffd678" stop-opacity="0"/></radialGradient>
      <radialGradient id="gLampCool"><stop offset="0" stop-color="#7fd9ff" stop-opacity=".18"/><stop offset="1" stop-color="#7fd9ff" stop-opacity="0"/></radialGradient>
      <linearGradient id="gCone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd678" stop-opacity=".16"/><stop offset="1" stop-color="#ffd678" stop-opacity="0"/></linearGradient>
      <linearGradient id="gConeCool" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fd9ff" stop-opacity=".14"/><stop offset="1" stop-color="#7fd9ff" stop-opacity="0"/></linearGradient>
      <linearGradient id="gSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#05080c"/><stop offset="1" stop-color="#0b1410"/></linearGradient>
      <linearGradient id="gDoorLight" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#3fe5b5" stop-opacity=".35"/><stop offset="1" stop-color="#3fe5b5" stop-opacity="0"/></linearGradient>
      <filter id="fGlow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <filter id="fGlowBig" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <clipPath id="cLiquid"><rect class="liq-level" x="-40" y="-6" width="80" height="80"/></clipPath>
      <clipPath id="cBulb"><path d="M-11-100 L-11-70 A32 32 0 1 0 11-70 L11-100 Z"/></clipPath>
      <clipPath id="cSwim"><rect x="-30" y="-46" width="60" height="60"/></clipPath>
      <clipPath id="cCoin"><rect x="-30" y="-52" width="60" height="60"/></clipPath>
    </defs>

    <g class="world">
      <!-- ═══════════ ROOM 1 · THE WALLET ═══════════ -->
      <g class="room1">
        <rect x="0" y="0" width="1200" height="560" fill="#1b1813"/>
        <rect x="0" y="0" width="1200" height="60" fill="#241f18"/>
        <rect x="0" y="560" width="1200" height="140" fill="#100e0b"/>
        <line x1="0" y1="560" x2="1200" y2="560" stroke="#3a3128" stroke-width="3"/>
        <g class="planks" stroke="#161310" stroke-width="2">
          <line x1="0" y1="600" x2="1200" y2="600"/><line x1="0" y1="650" x2="1200" y2="650"/>
        </g>
        <!-- lamps -->
        <g class="lamp-warm">
          <rect x="255" y="58" width="90" height="10" rx="5" fill="#39312a"/><polygon points="270,68 330,68 470,560 130,560" fill="url(#gCone)"/>
          <rect x="755" y="58" width="90" height="10" rx="5" fill="#39312a"/><polygon points="770,68 830,68 970,560 630,560" fill="url(#gCone)"/>
        </g>
        <text x="60" y="118" class="sign warm">THE WALLET</text>
        <text x="62" y="140" class="sub">WHERE TRANSACTIONS ARE BORN · OUTSIDE THE NODE</text>

        <!-- window with the node in the distance -->
        <g class="window">
          <rect x="970" y="160" width="200" height="180" rx="6" fill="#05080a" stroke="#3a352b" stroke-width="7"/>
          {win.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#dfe8e3" opacity=".6"/>)}
          <rect x="1060" y="230" width="60" height="110" fill="#0f1712"/>
          {[0, 1, 2, 3].map((i) => <><rect x="1068" y={242 + i * 22} width="10" height="7" fill="#0ac18e" opacity=".7"/><rect x="1102" y={242 + i * 22} width="10" height="7" fill="#0ac18e" opacity=".45"/></>)}
          <line x1="1090" y1="230" x2="1090" y2="205" stroke="#39463e" stroke-width="2"/><circle cx="1090" cy="203" r="3" fill="#e85d6b"/>
          <text x="1070" y="150" class="tiny" text-anchor="middle">the node · 1 hop away</text>
        </g>

        <!-- bench -->
        <rect x="260" y="470" width="680" height="16" fill="#3a3128"/><rect x="260" y="470" width="680" height="4" fill="#4a4033"/>
        <rect x="290" y="486" width="16" height="74" fill="#2b241d"/><rect x="894" y="486" width="16" height="74" fill="#2b241d"/>

        <!-- input coins: two vials on the bench -->
        <g class="vial vial-a" transform="translate(410 470)">
          <g class="vial-body">
            <rect x="-10" y="-46" width="20" height="46" rx="6" fill="#22302a" stroke="#9fb8ac" stroke-width="2"/>
            <rect class="vial-liq" x="-8" y="-34" width="16" height="32" rx="4" fill="#3fe5b5" opacity=".9"/>
            <rect x="-7" y="-54" width="14" height="9" rx="2" fill="#8a6a4a"/>
          </g>
        </g>
        <g class="vial vial-b" transform="translate(470 470)">
          <g class="vial-body">
            <rect x="-10" y="-46" width="20" height="46" rx="6" fill="#22302a" stroke="#9fb8ac" stroke-width="2"/>
            <rect class="vial-liq" x="-8" y="-30" width="16" height="28" rx="4" fill="#b26eff" opacity=".9"/>
            <rect x="-7" y="-54" width="14" height="9" rx="2" fill="#8a6a4a"/>
          </g>
        </g>
        <text id="lbl-utxo-title" x="440" y="506" class="tiny label-utxo" text-anchor="middle">YOUR UTXOs</text>
        <text id="lbl-in0" x="410" y="522" class="tiny g label-utxo-a" text-anchor="middle">30,000</text>
        <text id="lbl-in1" x="470" y="522" class="tiny v label-utxo-b" text-anchor="middle">17,500</text>
        <path class="stream stream-a" d="M612 438 Q604 452 602 468" />
        <path class="stream stream-b" d="M588 430 Q596 448 598 468" />

        <!-- output coins: blueprints of coins not yet born -->
        <g class="outputs">
          <g class="beaker beaker-pay" transform="translate(760 470)">
            <path d="M-16-50 h32 v18 l10 32 h-52 l10-32 z" fill="none" stroke="#3fe5b5" stroke-width="2" stroke-dasharray="5 4"/>
            <text id="lbl-pay-t" y="-58" class="tiny g" text-anchor="middle">PAYMENT</text>
            <text id="lbl-pay" y="18" class="tiny" text-anchor="middle">42,000 → merchant</text>
          </g>
          <g class="beaker beaker-chg" transform="translate(860 470)">
            <path d="M-13-42 h26 v16 l8 26 h-42 l8-26 z" fill="none" stroke="#c79dff" stroke-width="2" stroke-dasharray="5 4"/>
            <text id="lbl-chg-t" y="-50" class="tiny v" text-anchor="middle">CHANGE</text>
            <text id="lbl-chg" y="34" class="tiny" text-anchor="middle">5,100 → you</text><text id="lbl-more" x="70" y="-20" class="tiny dim" text-anchor="middle"></text>
          </g>
        </g>

        <!-- the stamp: signature seal -->
        <g class="stamp" transform="translate(600 330)">
          <rect x="-8" y="-60" width="16" height="50" rx="6" fill="#8a6a4a"/>
          <rect x="-34" y="-12" width="68" height="18" rx="4" fill="#5a4a3a" stroke="#8a6a4a" stroke-width="2"/>
          <text y="-20" class="tiny w" text-anchor="middle">SIGHASH_ALL | FORKID</text>
        </g>

        <!-- door -->
        <g class="door">
          <rect x="1090" y="380" width="100" height="180" fill="#0b0f0d"/>
          <rect class="door-light" x="1096" y="386" width="94" height="174" fill="url(#gDoorLight)"/>
          <rect class="door-leaf" x="1096" y="386" width="88" height="174" fill="#2b241d" stroke="#3a3128" stroke-width="2"/>
          <circle class="door-knob" cx="1170" cy="475" r="3" fill="#8a6a4a"/>
          <rect x="1086" y="376" width="108" height="8" fill="#3a3128"/>
          <text x="1140" y="368" class="tiny" text-anchor="middle">TO THE NETWORK →</text>
        </g>
      </g>

      <!-- ═══════════ ROOM 2 · THE NETWORK ═══════════ -->
      <g class="room2">
        <rect x="1200" y="0" width="1200" height="560" fill="url(#gSky)"/>
        <rect x="1200" y="560" width="1200" height="140" fill="#0c120f"/>
        <line x1="1200" y1="560" x2="2400" y2="560" stroke="#1f2a24" stroke-width="3"/>
        {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#dfe8e3" opacity={s.o}/>)}
        <text x="1260" y="118" class="sign cool">THE NETWORK</text>
        <text x="1262" y="140" class="sub">GOSSIP · EVERY NODE TELLS ITS PEERS · NOBODY IN CHARGE</text>

        <!-- wallet doorway you just walked out of -->
        <rect x="1200" y="380" width="60" height="180" fill="#1b1813"/><rect x="1200" y="376" width="66" height="8" fill="#3a3128"/>
        <text x="1250" y="600" class="tiny" text-anchor="middle">your wallet</text>

        <!-- gossip graph -->
        <g class="edges">
          {edges.map((e) => <line class={`edge edge-r${e.ring}`} x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y}/>)}
        </g>
        <g class="nodes">
          <circle class="node node-r0" cx={origin.x} cy={origin.y} r="9"/>
          {[...ring1, ...ring2, ...ring3].map((n) => <circle class={`node node-r${n.ring}`} cx={n.x} cy={n.y} r="6"/>)}
        </g>
        <text x={origin.x} y={origin.y - 18} class="tiny g" text-anchor="middle">you</text>
        <text x="1430" y="612" class="tiny ring-label ring-label-1" text-anchor="middle">your peers</text>
        <text x="1650" y="612" class="tiny ring-label ring-label-2" text-anchor="middle">their peers</text>
        <text x="1990" y="612" class="tiny ring-label ring-label-3" text-anchor="middle">the whole network · ~1 s</text>

        <!-- our node: the building we are about to enter -->
        <g class="tower">
          <rect x="2250" y="270" width="140" height="290" fill="#0f1712" stroke="#1f2a24" stroke-width="2"/>
          {[0, 1, 2, 3, 4, 5, 6].map((i) => <><rect x="2268" y={290 + i * 30} width="18" height="10" fill="#0ac18e" opacity={i % 2 ? ".55" : ".8"}/><rect x="2312" y={290 + i * 30} width="18" height="10" fill="#0ac18e" opacity={i % 2 ? ".8" : ".4"}/><rect x="2356" y={290 + i * 30} width="18" height="10" fill="#0ac18e" opacity=".5"/></>)}
          <line x1="2325" y1="270" x2="2325" y2="225" stroke="#39463e" stroke-width="3"/><circle cx="2325" cy="222" r="4" fill="#e85d6b" class="beacon"/>
          <circle class="node node-r4" cx={ourNode.x} cy={ourNode.y} r="8"/>
          <rect x="2296" y="490" width="58" height="70" fill="#070a09"/>
          <rect class="node-door-light" x="2298" y="492" width="54" height="68" fill="#3fe5b5" opacity="0"/>
          <rect class="node-door-leaf" x="2298" y="492" width="54" height="68" fill="#1a2420" stroke="#2e3833" stroke-width="2"/>
          <text x="2325" y="600" class="tiny g" text-anchor="middle">BITCOIN CASH FULL NODE</text>
          <text x="2325" y="616" class="tiny" text-anchor="middle">BCHN · peers: 14</text>
        </g>
      </g>

      <!-- ═══════════ ROOM 3 · THE VALIDATION GAUNTLET ═══════════ -->
      <g class="room3">
        <rect x="2400" y="0" width="1200" height="560" fill="#0f1614"/>
        <rect x="2400" y="0" width="1200" height="60" fill="#131c19"/>
        <rect x="2400" y="560" width="1200" height="140" fill="#0a100e"/>
        <line x1="2400" y1="560" x2="3600" y2="560" stroke="#27352d" stroke-width="3"/>
        <g stroke="#0b1210" stroke-width="2">{[0,1,2,3,4,5].map((i) => <line x1={2400 + i * 200} y1="60" x2={2400 + i * 200} y2="560"/>)}</g>
        <g class="lamp-cool">
          {[2560, 2760, 2960, 3200, 3380].map((x) => <><rect x={x - 45} y="58" width="90" height="10" rx="5" fill="#39463e"/><polygon points={`${x - 30},68 ${x + 30},68 ${x + 170},560 ${x - 170},560`} fill="url(#gConeCool)"/></>)}
        </g>
        <text x="2460" y="118" class="sign cool">THE VALIDATION GAUNTLET</text>
        <text x="2462" y="140" class="sub">FIVE CHECKS · EVERY NODE RUNS ALL OF THEM · ON EVERY TRANSACTION</text>

        <!-- 1 · well-formed: a scanner arch -->
        <g class="station st1" transform="translate(2560 560)">
          <path d="M-70 0 V-150 a70 70 0 0 1 140 0 V0" fill="none" stroke="#39463e" stroke-width="8"/>
          <path class="arch-beam" d="M-62 0 V-150 a62 62 0 0 1 124 0 V0" fill="none" stroke="#7fd9ff" stroke-width="2" opacity=".2"/>
          <circle class="lamp lamp-1" cx="0" cy="-246" r="7"/>
          <text y="-266" class="tiny" text-anchor="middle">1 · WELL-FORMED</text>
          <text id="lbl-form" class="readout readout-1" y="-284" text-anchor="middle">360 bytes · v2 · 2 in · 2 out</text>
          <text class="check check-1" y="-308" text-anchor="middle">✓</text>
        </g>

        <!-- 2 · inputs exist: the UTXO ledger cabinet -->
        <g class="station st2" transform="translate(2760 560)">
          <rect x="-60" y="-200" width="120" height="200" fill="#182420" stroke="#39463e" stroke-width="3"/>
          {[0,1,2,3,4,5].map((i) => <rect class={`drawer drawer-${i}`} x="-50" y={-190 + i * 32} width="100" height="26" rx="3"/>)}
          <text id="lbl-drawer-a" class="drawer-tag tag-a" x="0" y={-190 + 1 * 32 + 17} text-anchor="middle">…3c4b:1 · 30,000</text>
          <text id="lbl-drawer-b" class="drawer-tag tag-b" x="0" y={-190 + 4 * 32 + 17} text-anchor="middle">…e7f2:0 · 17,500</text>
          <circle class="lamp lamp-2" cx="0" cy="-220" r="7"/>
          <text y="-240" class="tiny" text-anchor="middle">2 · INPUTS EXIST · UTXO SET</text>
          <text class="check check-2" y="-262" text-anchor="middle">✓</text>
        </g>

        <!-- 3 · script: the stack machine -->
        <g class="station st3" transform="translate(2960 560)">
          <rect x="-40" y="-120" width="80" height="120" rx="6" fill="#182420" stroke="#39463e" stroke-width="3"/>
          <rect class="scan-beam" x="-34" y="-114" width="68" height="108" fill="#7fd9ff" opacity="0"/>
          <circle class="lamp lamp-3" cx="0" cy="-140" r="7"/>
          <text y="-160" class="tiny" text-anchor="middle">3 · SCRIPT</text>
          <text class="check check-3" y="-182" text-anchor="middle">✓</text>
          <!-- display panel, filled by script -->
          <g class="panel">
            <rect x="-150" y="-400" width="330" height="200" rx="6" fill="#0b1210" stroke="#39463e" stroke-width="2"/>
            <rect x="-150" y="-400" width="330" height="22" rx="6" fill="#182420"/>
            <text x="-140" y="-385" class="tiny">STACK MACHINE</text>
            <text id="op-title" x="172" y="-385" class="tiny g" text-anchor="end"></text>
            <line x1="-8" y1="-378" x2="-8" y2="-204" stroke="#1f2a24"/>
            <text x="-140" y="-362" class="tiny dim">SCRIPT</text>
            <text x="4" y="-362" class="tiny dim">STACK · top last</text>
            <g id="ops-col"></g>
            <g id="stack-col"></g>
          </g>
        </g>

        <!-- 4 · fee weigh-in: a scale -->
        <g class="station st4" transform="translate(3200 560)">
          <rect x="-6" y="-120" width="12" height="120" fill="#39463e"/>
          <g class="scale-beam">
            <rect x="-90" y="-124" width="180" height="6" rx="3" fill="#9fb8ac"/>
            <path d="M-80-120 v22 M-100-98 h40" stroke="#9fb8ac" stroke-width="3" fill="none"/>
            <path d="M80-120 v22 M60-98 h40" stroke="#9fb8ac" stroke-width="3" fill="none"/>
            <text id="lbl-fee" x="-80" y="-104" class="tiny w" text-anchor="middle">400 sats</text>
            <text id="lbl-size" x="80" y="-104" class="tiny" text-anchor="middle">360 B</text>
          </g>
          <circle class="lamp lamp-4" cx="0" cy="-150" r="7"/>
          <text y="-170" class="tiny" text-anchor="middle">4 · FEE</text>
          <text id="lbl-feerate" class="readout readout-4" y="-188" text-anchor="middle">1.11 sat/byte · min 1.0</text>
          <text class="check check-4" y="-212" text-anchor="middle">✓</text>
        </g>

        <!-- 5 · first-seen gate -->
        <g class="station st5" transform="translate(3380 560)">
          <rect x="-8" y="-150" width="16" height="150" fill="#39463e"/>
          <g class="turnstile"><rect x="-70" y="-98" width="140" height="8" rx="4" fill="#9fb8ac"/></g>
          <circle class="lamp lamp-5" cx="0" cy="-170" r="7"/>
          <text y="-190" class="tiny" text-anchor="middle">5 · FIRST SEEN</text>
          <text class="readout readout-5" y="-208" text-anchor="middle">inputs unspent · no conflict</text>
          <text class="check check-5" y="-232" text-anchor="middle">✓</text>
          <text class="dsproof" y="-260" text-anchor="middle">⚠ DSPROOF BROADCAST</text>
          <!-- the double-spend clone -->
          <g class="clone" transform="translate(60 0)">
            <g class="clone-body">
              <rect x="-14" y="-14" width="8" height="22" rx="4" fill="#9fb8ac"/><rect x="6" y="-14" width="8" height="22" rx="4" fill="#9fb8ac"/>
              <path d="M-11-100 L-11-70 A32 32 0 1 0 11-70 L11-100 Z" fill="#2a1418" stroke="#e85d6b" stroke-width="3"/>
              <path d="M-11-100 L-11-70 A32 32 0 1 0 11-70 L11-100 Z" fill="#e85d6b" opacity=".55" clip-path="url(#cBulb)"/>
              <rect x="-13" y="-108" width="26" height="12" rx="3" fill="#8a6a4a"/>
              <rect x="-24" y="-50" width="48" height="12" fill="#0b0f0d"/>
              <circle cx="-10" cy="-46" r="3" fill="#e85d6b"/><circle cx="10" cy="-46" r="3" fill="#e85d6b"/>
              <path d="M-8-30 q8-6 16 0" stroke="#0b0f0d" stroke-width="3" fill="none" stroke-linecap="round"/>
            </g>
            <text x="6" y="-152" class="tiny d" text-anchor="middle">same coin · spent twice</text>
          </g>
        </g>

        <!-- exit: to the mempool -->
        <g class="gate">
          <rect x="3520" y="360" width="80" height="200" fill="#070a09"/>
          <rect class="gate-light" x="3520" y="360" width="80" height="200" fill="url(#gDoorLight)"/>
          <rect class="gate-leaf" x="3522" y="362" width="76" height="198" fill="#1a2420" stroke="#2e3833" stroke-width="2"/>
          <rect x="3514" y="354" width="92" height="8" fill="#39463e"/>
          <text x="3560" y="344" class="tiny g" text-anchor="middle">MEMPOOL →</text>
        </g>
      </g>

      <!-- ═══════════ ROOM 4 · THE MEMPOOL ═══════════ -->
      <g class="room4">
        <rect x="3600" y="0" width="1200" height="560" fill="#101a17"/>
        <rect x="3600" y="0" width="1200" height="60" fill="#15211d"/>
        <rect x="3600" y="560" width="1200" height="140" fill="#0a100e"/>
        <line x1="3600" y1="560" x2="4800" y2="560" stroke="#27352d" stroke-width="3"/>
        <g class="lamp-warm">
          {[3800, 4150, 4500].map((x) => <><rect x={x - 45} y="58" width="90" height="10" rx="5" fill="#39463e"/><polygon points={`${x - 30},68 ${x + 30},68 ${x + 170},560 ${x - 170},560`} fill="url(#gCone)"/></>)}
        </g>
        <text x="3660" y="118" class="sign warm">THE MEMPOOL</text>
