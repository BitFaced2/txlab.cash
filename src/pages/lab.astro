---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Transaction Lab — txlab.cash">
  <div class="lab-page">
    {/* ─────────────────────── Header bar ─────────────────────── */}
    <div class="lab-header">
      <div class="lab-header-left">
        <div class="text-[10px] uppercase tracking-[0.2em] text-bch-500 font-mono font-semibold">
          // Transaction Lab
        </div>
        <h1 class="lab-title">The <span class="text-bch-500 font-mono">Laboratory</span></h1>
        <p class="lab-hint">one building, one full node — every room is a stage of a tx's life · click any creature to inspect · blocks arrive when they arrive</p>
      </div>

      <div class="lab-header-right">
        <div class="mode-chips" role="tablist">
          <span class="chip chip-active" role="tab" aria-selected="true">Mode 1 · Simulated</span>
          <span class="chip chip-soon" role="tab">Mode 2 · Chipnet</span>
          <span class="chip chip-soon" role="tab">Mode 3 · Mainnet</span>
        </div>
        <div class="controls">
          <div class="send-wrap" data-send-wrap>
            <button type="button" class="btn btn-primary" data-send-btn aria-haspopup="true" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22 11 13 2 9z"/></svg>
              Send BCH
            </button>
            <div class="send-menu" data-send-menu hidden>
              <button type="button" data-send-type="plain">Plain BCH</button>
              <button type="button" data-send-type="fungible">With token ducklings</button>
              <button type="button" data-send-type="nft">With an NFT pet</button>
            </div>
          </div>
          <button type="button" class="btn" data-pause-btn aria-pressed="false">
            <svg data-pause-icon width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            <svg data-play-icon width="10" height="10" viewBox="0 0 24 24" fill="currentColor" style="display:none"><polygon points="6 4 20 12 6 20 6 4"/></svg>
            <span data-pause-label>Pause</span>
          </button>
          <label class="speed-label">
            <span class="text-[10px] font-mono text-fg-mute uppercase tracking-wider">Speed</span>
            <input type="range" data-speed min="0.5" max="6" step="0.5" value="1" class="speed-slider"/>
            <span class="text-[10px] font-mono text-fg-mid" data-speed-value>1×</span>
          </label>
        </div>
      </div>
    </div>

    {/* ─────────────────────── Diorama (WebGL canvas) ─────────────────────── */}
    <div class="diorama-frame">
      <div class="diorama-host" data-lab-canvas></div>

      {/* Live status readout */}
      <div class="lab-readout">
        <div><span class="label">// block height</span> <span data-readout-height>892,000</span></div>
        <div><span class="label">// mempool</span> <span data-readout-mempool>0 txs</span></div>
        <div><span class="label">// last block sealed</span> <span data-readout-sealed>—</span></div>
        <div><span class="label">// dsproofs broadcast</span> <span data-readout-dsproof>0</span></div>
      </div>

      {/* Event toasts (DSProof gossip, confirmations) */}
      <div class="lab-toasts" data-toasts aria-live="polite"></div>

      {/* Tx inspector panel */}
      <aside class="lab-inspector" data-inspector hidden></aside>
    </div>
  </div>

  {/* ─────────────────── Legend / notes below the diorama ─────────────────── */}
  <section class="max-w-5xl mx-auto px-6 pt-8 pb-24">
    <div class="text-[10px] uppercase tracking-[0.2em] text-bch-500 font-mono font-semibold">
      // Legend
    </div>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-line bg-surface p-4">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full bg-bch-500"></span>
          <span class="text-sm text-fg">Plain BCH tx</span>
        </div>
        <p class="mt-1 text-xs text-fg-mute leading-relaxed">
          Flask-born green critter. The bread and butter — one signer, one recipient.
        </p>
      </div>
      <div class="rounded-lg border border-line bg-surface p-4">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full bg-neon-400"></span>
          <span class="text-sm text-fg">Fungible-token swarm</span>
        </div>
        <p class="mt-1 text-xs text-fg-mute leading-relaxed">
          Small colored ducklings trailing the creature — CashTokens travel with the UTXO.
        </p>
      </div>
      <div class="rounded-lg border border-line bg-surface p-4">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full" style="background:linear-gradient(135deg, var(--color-bch-500), var(--color-neon-400))"></span>
          <span class="text-sm text-fg">NFT pet</span>
        </div>
        <p class="mt-1 text-xs text-fg-mute leading-relaxed">
          One unique companion. Crown on top = the tx holds minting authority.
        </p>
      </div>
      <div class="rounded-lg border border-line bg-surface p-4">
        <div class="flex items-center gap-2">
          <span class="inline-block h-3 w-3 rounded-full" style="background: var(--color-danger)"></span>
          <span class="text-sm text-fg">Double-spend clone</span>
        </div>
        <p class="mt-1 text-xs text-fg-mute leading-relaxed">
          Red clone in a bandit mask, re-spending a UTXO someone already spent.
          The node rejects it the moment it arrives — first-seen wins, no RBF —
          and broadcasts a DSProof so merchants hear about the attempt in seconds.
        </p>
      </div>
    </div>
  </section>

  {/* ─────────────────── Boot the engine ─────────────────── */}
  <script>
    import { bootLab } from "../lab/boot";
    bootLab();
  </script>

  <style is:global>
    .lab-page {
      display: flex;
      flex-direction: column;
      background: var(--color-canvas);
    }

    .lab-header {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2rem;
      justify-content: space-between;
      align-items: flex-end;
      padding: 1.25rem 1.5rem 0.75rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }
    .lab-title {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--color-fg);
      margin: 0.25rem 0 0;
    }
    .lab-hint {
      margin: 0.35rem 0 0;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-fg-mute);
      letter-spacing: 0.05em;
    }
    .lab-header-right {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }

    .mode-chips { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .chip {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--color-line);
      color: var(--color-fg-mute);
      white-space: nowrap;
    }
    .chip-active {
      border-color: var(--color-bch-500);
      color: var(--color-bch-400);
      box-shadow: 0 0 12px -4px var(--color-bch-500);
    }
    .chip-soon { opacity: 0.55; }

    .controls { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.85rem;
      border-radius: 6px;
      border: 1px solid var(--color-line-mid);
      background: var(--color-surface);
      color: var(--color-fg-mid);
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
      transition: all 150ms;
    }
    .btn:hover { border-color: var(--color-bch-500); color: var(--color-bch-400); }
    .btn-primary {
      background: var(--color-bch-500);
      color: var(--color-canvas);
      border-color: var(--color-bch-500);
      font-weight: 600;
      font-family: var(--font-sans);
    }
    .btn-primary:hover { background: var(--color-bch-400); color: var(--color-canvas); }

    .speed-label { display: inline-flex; align-items: center; gap: 0.5rem; }
    .speed-slider {
      width: 90px;
      accent-color: var(--color-bch-500);
    }

    .diorama-frame {
      position: relative;
      max-width: 1400px;
      margin: 0.5rem auto 0;
      padding: 0 1.5rem;
      width: 100%;
    }
    .diorama-host {
      width: 100%;
      aspect-ratio: 1400 / 900;
      border: 1px solid var(--color-line-mid);
      border-radius: 8px;
      overflow: hidden;
      background: var(--color-canvas);
    }
    .diorama-canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    .lab-readout {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.4rem 1.25rem;
      margin: 8px 0 0 auto;
      width: fit-content;
      max-width: 100%;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-fg-mid);
      background: var(--color-surface);
      padding: 0.5rem 0.85rem;
      border: 1px solid var(--color-line-mid);
      border-radius: 4px;
    }
    .lab-readout .label {
      color: var(--color-fg-dim);
      margin-right: 0.35rem;
    }

    /* ── Send menu ── */
    .send-wrap { position: relative; }
    .send-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 40;
      display: flex;
      flex-direction: column;
      min-width: 190px;
      background: var(--color-surface);
      border: 1px solid var(--color-line-mid);
      border-radius: 6px;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }
    .send-menu button {
      padding: 0.55rem 0.8rem;
      text-align: left;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--color-fg-mid);
      background: none;
      border: none;
      cursor: pointer;
    }
    .send-menu button:hover { background: var(--color-elevated); color: var(--color-bch-400); }

    /* ── Event toasts ── */
    .lab-toasts {
      position: absolute;
      top: 14px;
      left: 36px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 30;
      pointer-events: none;
      max-width: 380px;
    }
    .toast {
      font-family: var(--font-mono);
      font-size: 10.5px;
      line-height: 1.4;
      color: var(--color-fg-mid);
      background: rgb(from var(--color-canvas) r g b / 0.92);
      border: 1px solid var(--color-line-mid);
      border-left-width: 3px;
      border-radius: 4px;
      padding: 0.45rem 0.7rem;
      animation: toast-in 250ms ease-out;
    }
    .toast-dsproof { border-left-color: var(--color-danger); color: var(--color-fg); }
    .toast-good { border-left-color: var(--color-bch-500); }
    .toast-info { border-left-color: var(--color-neon-500); }
    .toast-out { opacity: 0; transition: opacity 400ms; }
    @keyframes toast-in {
      from { opacity: 0; transform: translateX(-10px); }
      to   { opacity: 1; transform: translateX(0); }
    }

    /* ── Tx inspector ── */
    .lab-inspector {
      position: absolute;
      bottom: 12px;
      left: 36px;
      width: 300px;
      max-width: calc(100% - 72px);
      z-index: 30;
      background: rgb(from var(--color-canvas) r g b / 0.95);
      border: 1px solid var(--color-line-mid);
      border-radius: 6px;
      padding: 0.6rem 0.75rem 0.7rem;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-fg-mid);
    }
    .ins-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--color-bch-400);
      font-size: 10px;
      letter-spacing: 0.15em;
      margin-bottom: 0.45rem;
    }
    .ins-head button {
      background: none;
      border: none;
      color: var(--color-fg-mute);
      font-size: 14px;
      cursor: pointer;
      line-height: 1;
      padding: 2px 4px;
    }
    .ins-head button:hover { color: var(--color-fg); }
    .ins-rows > div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.5px 0;
    }
    .ins-rows > div > span:first-child { color: var(--color-fg-dim); }
    .ins-rows > div > span:last-child { text-align: right; }
    .ins-good { color: var(--color-bch-400); }
    .ins-bad { color: var(--color-danger); }
    .ins-note {
      margin: 0.5rem 0 0;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-line);
      color: var(--color-fg-mute);
      line-height: 1.5;
    }
    .ins-note b { color: var(--color-fg-mid); font-weight: 600; }

    @media (prefers-reduced-motion: reduce) {
      .toast { animation: none !important; }
    }
  </style>
</BaseLayout>
